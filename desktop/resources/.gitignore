# Platform media tools are downloaded and SHA256-verified during packaging.
# They belong in the release artifact, not in the source repository.
ffmpeg/
exiftool/
.downloads/

# Staged by `go run ./cmd/devtool package` for the packager to ship: the Web
# SPA, the license notices, and the native libraries of one platform.
web/
licenses/
darwin-*/
windows-*/

# The signed payload is generated from the staged tools before packaging.
payload/*
!payload/.gitkeep
