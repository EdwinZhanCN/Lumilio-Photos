<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="desktop"
        Arguments=""
        InstallLocation="C:\Program Files\Lumilio Photos\Lumilio Photos">
    </Installer>
    <PackageInformation
        PackageName="Lumilio Photos"
        PackageDisplayName="Lumilio Photos"
        PublisherName="CN=Lumilio Photos"
        PublisherDisplayName="Lumilio Photos"
        Version="0.1.0.0"
        PackageDescription="A desktop application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.lumilio.photos.desktop"
                Description="A desktop application"
                DisplayName="Lumilio Photos"
                ExecutableName="desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Lumilio Photos</DisplayName>
            <PublisherDisplayName>Lumilio Photos</PublisherDisplayName>
            <Description>A desktop application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
